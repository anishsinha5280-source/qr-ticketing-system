# ---------------------------------------------------------------------------
# CampusPass — environment variables
# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=replace-me-with-a-long-random-string
AUTH_JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=ets_session

# --- Ticket signing ---------------------------------------------------------
# Separate secret for the QR ticket tokens (HMAC-SHA256 / JWT).
# Rotating it invalidates every previously issued QR code.
TICKET_SIGNING_SECRET=replace-me-with-another-long-random-string
TICKET_ISSUER=campus-event-ticketing
# Hours after an event ends during which its tickets still verify.
TICKET_GRACE_HOURS=24

# --- Email (Resend) ---------------------------------------------------------
# Leave RESEND_API_KEY empty in development to run the safe mock mailer
# (emails are logged to the console + email_logs table instead of sent).
RESEND_API_KEY=
EMAIL_FROM=Campus Events <no-reply@yourdomain.com>
# Set to true to force mock mode even when an API key is present.
EMAIL_MOCK_MODE=false

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CampusPass
# Timezone used for every rendered date (keeps SSR and client output identical)
NEXT_PUBLIC_APP_TIMEZONE=UTC

# --- Misc -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
DRIZZLE_MIGRATIONS_FOLDER=drizzle
